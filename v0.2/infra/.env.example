# Klimate Kundli v0.2 — example env. Copy to .env at repo root or per app.

# --- Supabase (serving DB) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # only on server side

# --- Cloudflare R2 (archive bucket) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=klimate-archive
R2_ENDPOINT=https://YOUR-ACCOUNT.r2.cloudflarestorage.com

# --- Copernicus CDS ---
# In addition to setting these, write ~/.cdsapirc with the same key/url.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- Service ports (dev) ---
API_PORT=3002
WEB_PORT=5174
