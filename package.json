{
  "name": "klimate-kundli-backend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "redeploy": "bash deploy/redeploy-api.sh",
    "start": "node dist/index.js",
    "test": "vitest run tests",
    "fetch:static": "tsx src/scripts/fetch_static_data.ts",
    "prewarm": "tsx src/scripts/prewarm.ts",
    "prewarm:generate-batch": "tsx src/scripts/generate-prewarm-batch.ts",
    "imd:spike": "tsx src/scripts/imd-spike.ts",
    "imd:diagnose": "tsx src/scripts/imd-diagnose.ts",
    "imd:build-station-map": "tsx src/scripts/imd-build-station-map.ts",
    "imd:ingest": "./.venv/bin/python scripts/imd-ingest.py",
    "capture:docs": "node scripts/capture/capture.mjs"
  },
  "dependencies": {
    "@fontsource-variable/alegreya": "^5.2.8",
    "@hono/node-server": "latest",
    "@paper-design/shaders-react": "^0.0.76",
    "better-sqlite3": "latest",
    "hono": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "^25.7.0",
    "all-the-cities": "^3.1.0",
    "i18n-iso-countries": "^7.14.0",
    "puppeteer": "^25.0.4",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
