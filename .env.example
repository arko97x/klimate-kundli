PORT=8787
NODE_ENV=production
CACHE_PATH=./data/cache.sqlite

# IMD (India) — https://api.imd.gov.in — Prod key whitelisted to server IP
# IMD_API_KEY=          # 64-char generated key → X-API-KEY header
# IMD_EMAIL=            # Portal login → JWT via POST /api/oauth/token.php (refreshes hourly)
# IMD_PASSWORD=
# IMD_JWT_TOKEN=        # Optional fallback if oauth creds not set (expires — manual refresh)

# Optional: shorten delay for smoke tests only (default 30 min between cities)
# PREWARM_REQUEST_DELAY_MS=5000

# Saved kundlis (Supabase Postgres). Without these, kundlis use in-memory store (lost on restart).
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
