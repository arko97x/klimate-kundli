PORT=8787
NODE_ENV=production
CACHE_PATH=./data/cache.sqlite

# IMD (India) — https://api.imd.gov.in — Prod key whitelisted to server IP
# IMD_API_KEY=          # 64-char generated key → X-API-KEY header
# IMD_EMAIL=            # Portal login → JWT via POST /api/oauth/token.php (refreshes hourly)
# IMD_PASSWORD=
# IMD_JWT_TOKEN=        # Optional fallback if oauth creds not set (expires — manual refresh)

# Optional: shorten delay for smoke tests only (default 30 min between cities)
# PREWARM_REQUEST_DELAY_MS=5000

# Saved kundlis (Supabase Postgres). Without these, kundlis use in-memory store (lost on restart).
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Snapshot capture script → API guard for updating frozen screenshot manifests.
# KUNDLI_SNAPSHOT_TOKEN=generate-a-long-random-token
# Optional: backend POSTs { "slug": "..." } here after saving a new kundli.
# KUNDLI_SNAPSHOT_WEBHOOK_URL=https://your-snapshot-worker.example.com/capture
# KUNDLI_SNAPSHOT_WEBHOOK_SECRET=shared-secret-for-worker
# KUNDLI_SNAPSHOT_WEBHOOK_AUTHORIZATION=Bearer optional-worker-token
#
# Alternative: trigger the included GitHub Actions worker via repository_dispatch.
# KUNDLI_SNAPSHOT_GITHUB_REPO=owner/repo
# KUNDLI_SNAPSHOT_GITHUB_TOKEN=github-token-with-repository-dispatch-access
