[Unit]
Description=Cloudflare Quick Tunnel → Klimate Kundli API
After=network-online.target klimate-kundli.service
Wants=network-online.target
Requires=klimate-kundli.service

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8787
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
